# ==============================================================================
# ARAADHYA FASHION - UNIFIED COMMERCE HUB CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. SHOPIFY CONFIGURATION (Website & Inventory & Orders)
# Where to find: Shopify Admin > Settings > Apps and sales channels > Develop apps
# Create Custom App -> grant Admin API permissions (read/write products, orders, inventory)
# ------------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=araadhya-fashion.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. RAZORPAY CONFIGURATION (Payment Gateway & Dynamic Payment Links)
# Where to find: Razorpay Dashboard > Settings > API Keys (Generate Key ID & Secret)
# Webhooks: Razorpay Dashboard > Settings > Webhooks (Add Webhook URL & Secret)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. META / WHATSAPP CLOUD API CONFIGURATION
# Where to find: developers.facebook.com > Your App > WhatsApp > API Setup
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_WEBHOOK_VERIFY_TOKEN=araadhya_fashion_verify_token_secure_123

# WhatsApp specific (from Meta WhatsApp Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id

# ------------------------------------------------------------------------------
# 4. INSTAGRAM & FACEBOOK GRAPH API CONFIGURATION
# Where to find: Meta Business Suite / Graph API Explorer
# ------------------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PIXEL_ID=your_facebook_pixel_id
