{%- comment -%} Araadhya reviews: cards with optional customer photo and a small avatar {%- endcomment -%}
<style>
.aarv{font-family:'DM Sans',system-ui,sans-serif;background:#F7F1EC;padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px}
.aarv *{box-sizing:border-box;letter-spacing:normal}
.aarv__in{max-width:1296px;margin:0 auto;padding:0 24px}
.aarv__hd{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:24px}
.aarv__h{font-family:Marcellus,serif!important;font-weight:400!important;font-size:clamp(24px,2.4vw,32px);color:#1E1B18;margin:0}
.aarv__sub{font-size:14px;color:#6B635B;margin:6px 0 0}
.aarv__nav{display:flex;gap:8px}
.aarv__nav button{width:40px;height:40px;border-radius:20px;border:1px solid #D9CFC4;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#1E1B18}
.aarv__nav button:hover{background:#1F5752;border-color:#1F5752;color:#fff}
.aarv__track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}
.aarv__track::-webkit-scrollbar{display:none}
.aarv__card{flex:0 0 calc((100% - 48px)/4);min-width:0;scroll-snap-align:start;background:#fff;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;border:1px solid #EEE7E0}
.aarv__ph{aspect-ratio:4/5;background:#EDE6DD;overflow:hidden}
.aarv__ph img{width:100%;height:100%;object-fit:cover;display:block}
.aarv__b{padding:18px;display:flex;flex-direction:column;gap:10px;flex:1}
.aarv__st{color:#B7791F;font-size:15px;letter-spacing:2px}
.aarv__t{font-size:14px;line-height:1.6;color:#3A342F;margin:0;flex:1}
.aarv__who{display:flex;align-items:center;gap:10px;margin-top:4px}
.aarv__av{flex:0 0 38px;width:38px;height:38px;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;color:#fff}
.aarv__av img{width:100%;height:100%;object-fit:cover;display:block}
.aarv__av svg{width:22px;height:22px}
.aarv__wn{display:flex;flex-direction:column;gap:2px;min-width:0}
.aarv__n{font-size:13px;font-weight:700;color:#1E1B18;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.aarv__v{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:#1D7BC4;font-weight:600}
@media(max-width:989px){.aarv__card{flex-basis:calc((100% - 16px)/2.3)}}
@media(max-width:600px){.aarv__in{padding:0 16px}.aarv__card{flex-basis:78%}.aarv__nav{display:none}}
</style>
<section class="aarv">
  <div class="aarv__in">
    <div class="aarv__hd">
      <div>
        <h2 class="aarv__h">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}<p class="aarv__sub">{{ section.settings.sub }}</p>{%- endif -%}
      </div>
      <div class="aarv__nav"><button type="button" aria-label="Previous reviews" data-p><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" aria-label="Next reviews" data-n><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button></div>
    </div>
    <div class="aarv__track" data-track>
      {%- assign pal = '#1F5752,#A0522D,#7B4F8E,#B7791F,#3F6E9A,#9C3D54,#4F7A3A' | split: ',' -%}
      {%- for b in section.blocks -%}
        {%- liquid
          assign nm = b.settings.name | strip
          assign nml = nm | downcase
          assign generic = false
          if nm == blank or nml contains 'customer'
            assign generic = true
          endif
          assign ini = nm | slice: 0 | upcase
          assign ci = forloop.index0 | modulo: pal.size
        -%}
      <article class="aarv__card" {{ b.shopify_attributes }}>
        {%- if b.settings.photo -%}<div class="aarv__ph">{{ b.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.settings.name }}</div>{%- endif -%}
        <div class="aarv__b">
          <div class="aarv__st" aria-label="5 out of 5 stars">★★★★★</div>
          <p class="aarv__t">{{ b.settings.text }}</p>
          <div class="aarv__who">
            <span class="aarv__av" style="background:{% if generic %}#C9BFB4{% else %}{{ pal[ci] }}{% endif %}" aria-hidden="true">
              {%- if b.settings.avatar -%}{{ b.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
              {%- elsif generic -%}<svg viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="8.5" r="4.2"/><path d="M3.8 21c.6-4.3 4-7 8.2-7s7.6 2.7 8.2 7z"/></svg>
              {%- else -%}{{ ini }}{%- endif -%}
            </span>
            <span class="aarv__wn">
              <span class="aarv__n">{{ b.settings.name }}</span>
              <span class="aarv__v"><svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#1D9BF0"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Verified buyer</span>
            </span>
          </div>
        </div>
      </article>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function(){var s=document.currentScript.previousElementSibling,t=s.querySelector('[data-track]');if(!t)return;
function step(){var c=t.querySelector('.aarv__card');return c?c.offsetWidth+16:300}
s.querySelector('[data-p]').addEventListener('click',function(){t.scrollBy({left:-step(),behavior:'smooth'})});
s.querySelector('[data-n]').addEventListener('click',function(){t.scrollBy({left:step(),behavior:'smooth'})});})();
</script>
{% schema %}
{
  "name": "Araadhya reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Feedback from shoppers across the Araadhya collection." },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "photo", "label": "Customer photo (optional)" },
      { "type": "image_picker", "id": "avatar", "label": "Customer's own profile photo (optional, with her permission)" },
      { "type": "textarea", "id": "text", "label": "Review" },
      { "type": "text", "id": "name", "label": "Name" }
    ] }
  ],
  "presets": [{ "name": "Araadhya reviews" }]
}
{% endschema %}
