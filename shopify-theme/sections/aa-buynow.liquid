{%- comment -%}
  Araadhya Fashion - Buy Now & Magic Checkout Controller
  Stages selected items into cart and triggers Razorpay 1-Click Magic Checkout
{%- endcomment -%}

<form id="aa-magic-checkout-form" action="{{ routes.cart_url }}" method="post" style="display:none!important;" aria-hidden="true">
  <button type="submit" id="aa-magic-checkout-btn" name="checkout" value="Checkout">Checkout</button>
</form>

<script>
(() => {
  const routesRoot = window.Shopify?.routes?.root || '/';
  let pending = Promise.resolve();
  let refreshing = false;
  let lastCount = null;

  async function cartRequest(path, body) {
    const options = { cache: 'no-store', headers: { Accept: 'application/json' } };
    if (body) {
      options.method = 'POST';
      options.headers['Content-Type'] = 'application/json';
      options.body = JSON.stringify(body);
    }
    const response = await fetch(routesRoot + path, options);
    const data = await response.json();
    if (!response.ok) throw data;
    return data;
  }

  function open() {
    const cartLinks = Array.from(document.querySelectorAll('a.m-cart-icon-bubble'));
    const trigger = cartLinks.find(link => link.getClientRects().length);
    if (trigger) trigger.click();
    else window.location.assign(routesRoot + 'cart');
  }

  async function refresh() {
    if (document.hidden || refreshing) return;
    refreshing = true;
    try {
      const cart = await cartRequest('cart.js');
      if (cart.item_count === lastCount) return;
      lastCount = cart.item_count;
      const count = lastCount > 99 ? '99+' : String(lastCount);
      document.querySelectorAll('.m-cart-count-bubble, m-cart-count, [data-cart-count], .cart-count-bubble span').forEach(element => {
        element.textContent = count;
        element.classList.toggle('m:hidden', lastCount === 0);
        element.style.display = lastCount === 0 ? 'none' : '';
      });
      document.querySelectorAll('a.m-cart-icon-bubble').forEach(element => {
        element.setAttribute('aria-label', `Cart, ${count} ${lastCount === 1 ? 'item' : 'items'}`);
      });
    } catch (error) {
    } finally {
      refreshing = false;
    }
  }

  async function prepareBuyNow(items) {
    // Ultra-fast single POST to Shopify cart/add.js
    return await cartRequest('cart/add.js', { items });
  }

  function triggerCheckout() {
    // 1. Dedicated Razorpay checkout button intercepted by magic-shopify.js
    const magicBtn = document.getElementById('aa-magic-checkout-btn');
    if (magicBtn) {
      magicBtn.click();
      return;
    }
    // 2. Fallback to cart drawer checkout button
    const drawerBtn = document.querySelector('button[name="checkout"], form[action*="/cart"] button[name="checkout"]');
    if (drawerBtn) {
      drawerBtn.click();
      return;
    }
    // 3. Native checkout fallback
    window.location.assign(routesRoot + 'checkout');
  }

  function submit(items, buyNow) {
    const operation = pending.then(async () => {
      // Single direct network trip to add items to cart
      await cartRequest('cart/add.js', { items });
      
      if (buyNow) {
        // Fast-path: Trigger Razorpay 1-Click checkout immediately
        // without competing background GET cart.js calls
        triggerCheckout();
      } else {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        refresh();
        open();
      }
    });
    pending = operation.catch(() => {});
    return operation;
  }

  window.AACD = { open, refresh, submit, triggerCheckout };
  refresh();
  window.setInterval(refresh, 2500);
  window.addEventListener('focus', refresh);
})();
</script>
