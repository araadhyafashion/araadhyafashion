{%- comment -%}
  Araadhya Fashion - Psychological Price Anchoring & Collection Lineup
  Modeled after Apple's tiered lineup to anchor ₹499 against ₹4,949 couture
{%- endcomment -%}

<style>
  .aa-anchor {
    font-family: 'DM Sans', system-ui, sans-serif;
    background: #FAFAF8;
    padding: {{ section.settings.pt | default: 60 }}px 20px {{ section.settings.pb | default: 60 }}px;
    color: #1E1B18;
  }
  .aa-anchor * {
    box-sizing: border-box;
  }
  .aa-anchor-in {
    max-width: 1240px;
    margin: 0 auto;
  }
  .aa-anchor-hd {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
  }
  .aa-anchor-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1F5752;
    margin-bottom: 8px;
  }
  .aa-anchor-hd h2 {
    font-family: Marcellus, serif;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 400;
    margin: 0 0 12px;
    color: #1E1B18;
  }
  .aa-anchor-hd p {
    font-size: 15px;
    color: #6B635B;
    margin: 0;
    line-height: 1.5;
  }
  .aa-anchor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }
  .aa-anchor-card {
    background: #FFFFFF;
    border: 1px solid #EBE4DC;
    border-radius: 16px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .aa-anchor-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 27, 24, 0.08);
  }
  .aa-anchor-card.is-featured {
    border: 2px solid #1F5752;
    background: #FFF;
    box-shadow: 0 8px 28px rgba(31, 87, 82, 0.1);
  }
  .aa-anchor-badge {
    position: absolute;
    top: -12px;
    left: 24px;
    background: #1F5752;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
  }
  .aa-anchor-tier {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #B7791F;
    margin-bottom: 6px;
  }
  .aa-anchor-title {
    font-family: Marcellus, serif;
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 12px;
    color: #1E1B18;
  }
  .aa-anchor-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #F0EAE3;
  }
  .aa-anchor-price strong {
    font-size: 32px;
    font-weight: 700;
    color: #1E1B18;
  }
  .aa-anchor-price span {
    font-size: 13px;
    color: #8C8278;
  }
  .aa-anchor-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .aa-anchor-features li {
    font-size: 14px;
    color: #3A342F;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.4;
  }
  .aa-anchor-features svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: #1F5752;
  }
  .aa-anchor-btn {
    height: 48px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .aa-anchor-btn.btn-outline {
    border: 1.5px solid #1F5752;
    background: transparent;
    color: #1F5752;
  }
  .aa-anchor-btn.btn-outline:hover {
    background: #1F5752;
    color: #FFF;
  }
  .aa-anchor-btn.btn-solid {
    border: none;
    background: #1F5752;
    color: #FFF;
  }
  .aa-anchor-btn.btn-solid:hover {
    background: #163F3B;
  }

  @media (max-width: 989px) {
    .aa-anchor-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .aa-anchor-card {
      padding: 24px 20px;
    }
  }
</style>

<section class="aa-anchor">
  <div class="aa-anchor-in">
    <div class="aa-anchor-hd">
      <span class="aa-anchor-tag">{{ section.settings.sub_heading | default: 'The Chikankari Lineup' }}</span>
      <h2>{{ section.settings.heading | default: 'Explore the Craft &amp; Collections' }}</h2>
      <p>{{ section.settings.description | default: 'Authentic Lucknowi artistry tailored for every budget — from daily breathable cottons to handcrafted heirloom bridal couture.' }}</p>
    </div>

    <div class="aa-anchor-grid">
      <!-- Tier 1: Daily Everyday Value (The Hero Traffic Driver) -->
      <div class="aa-anchor-card">
        <span class="aa-anchor-tier">Everyday Elegance</span>
        <h3 class="aa-anchor-title">Daily Wear Kurtis</h3>
        <div class="aa-anchor-price">
          <strong>₹499</strong>
          <span>Inclusive of taxes</span>
        </div>
        <ul class="aa-anchor-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>100% Breathable Cambric Cotton</strong> for all-day comfort</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Delicate shadow-work inspired embroidery</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Pre-washed &amp; shrink-resistant for easy daily machine care</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Standard sizes 36 to 48 available</span>
          </li>
        </ul>
        <a href="/collections/under-499" class="aa-anchor-btn btn-outline">Explore ₹499 Kurtis</a>
      </div>

      <!-- Tier 2: Festive Artisan Sets (The Volume Anchor) -->
      <div class="aa-anchor-card is-featured">
        <span class="aa-anchor-badge">Most Popular</span>
        <span class="aa-anchor-tier">Festive &amp; Occasion</span>
        <h3 class="aa-anchor-title">3-Piece Suit Sets</h3>
        <div class="aa-anchor-price">
          <strong>₹1,999</strong>
          <span>Complete 3-piece set</span>
        </div>
        <ul class="aa-anchor-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>Pure Modal Cotton &amp; Chanderi Silk</strong> rich festive drape</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Authentic Ghaspatti &amp; Phanda stitches by master artisans</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Matching embroidered pants &amp; shaded chiffon dupatta</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Hand-finished potli buttons and custom lace trims</span>
          </li>
        </ul>
        <a href="/collections/suit-sets" class="aa-anchor-btn btn-solid">Shop Festive Suit Sets</a>
      </div>

      <!-- Tier 3: The Luxury Anchor (Makes ₹499 look like a no-brainer) -->
      <div class="aa-anchor-card">
        <span class="aa-anchor-tier">Heritage Couture</span>
        <h3 class="aa-anchor-title">3D Georgette Couture</h3>
        <div class="aa-anchor-price">
          <strong>₹4,949</strong>
          <span>Artisan heirloom piece</span>
        </div>
        <ul class="aa-anchor-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>32+ Artisan Hand-Stitch Hours</strong> in old Lucknow workshops</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Heavy 3D Floral Chikankari with genuine Mukaish &amp; Pearls</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Pure Viscose 60g Georgette with modal inner slip included</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Bespoke video consultation and made-to-measure fitting</span>
          </li>
        </ul>
        <a href="/collections/chikankari-kurtas" class="aa-anchor-btn btn-outline">Discover Heirloom Couture</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Price Anchor Lineup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "sub_heading", "label": "Subheading", "default": "The Chikankari Lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the Craft & Collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Authentic Lucknowi artistry tailored for every budget — from daily breathable cottons to handcrafted heirloom bridal couture." },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "Price Anchor Lineup" }
  ]
}
{% endschema %}
