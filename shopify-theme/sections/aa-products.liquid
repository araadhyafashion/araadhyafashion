{%- assign col = section.settings.collection -%}
{%- if col != blank and col.products_count > 0 -%}
<style>
.aapr{font-family:'DM Sans',system-ui,sans-serif;color:#1E1B18;max-width:1296px;margin:0 auto;padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px}
.aapr *{box-sizing:border-box;letter-spacing:normal;text-transform:none}
.aa-div{position:relative;border-top:2px dashed #B7791F;margin:0 0 4px}
.aa-div span{position:absolute;right:16px;top:-12px;background:#B7791F;color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:12px}
.aapr__hd{display:flex;justify-content:space-between;align-items:baseline;padding:20px 16px 14px}
.aapr__hd h2{font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0;color:#1E1B18}
.aapr__hd a{font-size:13px;color:#1F5752;text-decoration:underline}
.aapr__row{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 16px 6px;scrollbar-width:none}
.aapr__row::-webkit-scrollbar{display:none}
.aapr__c{flex:0 0 calc(44% - 7px);width:calc(44% - 7px);min-width:0;max-width:calc(44% - 7px);scroll-snap-align:start;color:#1E1B18;display:flex;flex-direction:column;gap:8px}
.aapr__lk{display:flex;flex-direction:column;gap:4px;color:#1E1B18;text-decoration:none}
.aapr__im{position:relative;aspect-ratio:3/4;height:auto;min-height:0;border-radius:12px;overflow:hidden;background:#F7F1EC;margin-bottom:6px}
.aapr__im img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;display:block;transition:transform .4s}
.aapr__c:hover .aapr__im img{transform:scale(1.03)}
.aapr__bd{position:absolute;top:8px;left:8px;background:#A23B2A;color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:5px}
.aapr__t{display:block;max-width:100%;font-size:14px;line-height:1.3;min-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.aapr__size{font-size:12px;line-height:1.4;color:#1F5752}
.aapr__p b{font-size:16px;font-weight:700}.aapr__p s{font-size:13px;color:#8F877F;margin-left:6px}
.aapr__wl{position:absolute;top:8px;right:8px;width:34px;height:34px;border-radius:17px;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;color:#1E1B18;cursor:pointer;z-index:2}
.aapr__wl.added-to-wishlist{color:#A23B2A}.aapr__wl.added-to-wishlist path{fill:#A23B2A}
.aapr__sw{display:flex;gap:5px;margin-top:2px}.aapr__sw i{width:13px;height:13px;border-radius:50%;border:1px solid #DDD3C8}
.aapr__b{display:flex;gap:8px;margin-top:auto}
.aapr__bag{flex:0 0 40px;width:40px;height:40px;border-radius:8px;border:1.5px solid #1F5752;background:#fff;color:#1F5752;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;text-decoration:none}
.aapr__buy{flex:1;height:40px;border-radius:8px;border:0;background:#1F5752;color:#fff!important;font:600 14px 'DM Sans',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none!important;white-space:nowrap}
.aapr__bag[disabled],.aapr__buy[disabled]{opacity:.55;cursor:wait}
.aapr__so{flex:1;height:40px;border-radius:8px;background:#F4F1EE;color:#8F877F;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center}
.aapr__toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);z-index:60;background:#1E1B18;color:#fff;font:500 13px 'DM Sans',system-ui,sans-serif;padding:10px 16px;border-radius:8px;display:none;gap:12px;align-items:center;white-space:nowrap}
.aapr__toast.on{display:flex}.aapr__toast a{color:#fff;font-weight:700;text-decoration:underline}
@media(min-width:768px){.aapr__hd{padding:28px 32px 18px}.aapr__hd h2{font-size:30px}.aapr__row{padding:0 32px 6px;gap:20px}.aapr__c{flex-basis:calc(25% - 15px);width:calc(25% - 15px);max-width:calc(25% - 15px)}.aa-div span{right:32px}}
</style>
<div class="aapr" id="aapr-{{ section.id }}">
  {%- if section.settings.divider -%}<div class="aa-div">{%- if section.settings.badge != blank -%}<span>{{ section.settings.badge }}</span>{%- endif -%}</div>{%- endif -%}
  <div class="aapr__hd"><h2>{{ section.settings.heading }}</h2><a href="{{ col.url }}">{{ section.settings.view_all }}</a></div>
  <div class="aapr__row">
    {%- for p in col.products limit: section.settings.limit -%}
      {%- liquid
        assign avail = p.variants | where: 'available'
        assign size_option = p.options_by_name['Size']
        assign available_sizes = '' | split: ','
        if size_option != blank
          assign size_property = 'option' | append: size_option.position
          assign available_sizes = avail | map: size_property | uniq
        endif
      -%}
      <div class="aapr__c">
        <a class="aapr__lk" href="{{ p.url }}">
          <div class="aapr__im">
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 768px) 25vw, 45vw' }}{%- endif -%}
            {%- if p.compare_at_price > p.price -%}{%- assign off = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}<span class="aapr__bd">{{ off }}% OFF</span>{%- endif -%}<span class="m-wishlist-button aapr__wl" role="button" tabindex="0" aria-label="Add to wishlist" data-product-handle="{{ p.handle }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0112 7.6a4.3 4.3 0 017.5 2.7c0 5.6-7.5 10.2-7.5 10.2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
          </div>
          <div class="aapr__t">{{ p.title }}</div>
          <div class="aapr__p"><b>{{ p.price | money_without_trailing_zeros }}</b>{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</div>
          {%- if available_sizes.size == 1 -%}
            <div class="aapr__size">Size {{ available_sizes.first | escape }} available</div>
          {%- elsif available_sizes.size > 1 -%}
            <div class="aapr__size">Available sizes: {{ available_sizes | join: ', ' | escape }}</div>
          {%- endif -%}
          {%- for opt in p.options_with_values -%}
            {%- assign on = opt.name | downcase -%}
            {%- if on == 'colour' or on == 'color' -%}
              <div class="aapr__sw">
                {%- for v in opt.values limit: 5 -%}
                  {%- liquid
                    assign vd = v | downcase | strip
                    assign hex = '#DDD3C8'
                    assign pcs = settings.product_colors | split: ','
                    for pc in pcs
                      assign parts = pc | strip | split: ':'
                      assign nm = parts.first | downcase | strip
                      if nm == vd
                        assign hex = parts.last | strip
                      endif
                    endfor
                  -%}
                  <i style="background:{{ hex }}" title="{{ v | escape }}"></i>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </a>
        <div class="aapr__b">
          {%- if p.available == false -%}
            <span class="aapr__so">Sold out</span>
          {%- elsif p.variants.size == 1 and avail.size == 1 -%}
            <button type="button" class="aapr__bag" data-qa="cart" data-v="{{ avail.first.id }}" aria-label="Add {{ p.title | escape }} to cart"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg></button>
            <button type="button" class="aapr__buy" data-qa="buy" data-v="{{ avail.first.id }}">Buy now</button>
          {%- else -%}
            <a class="aapr__bag" href="{{ p.url }}" aria-label="Choose size for {{ p.title | escape }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg></a>
            <a class="aapr__buy" href="{{ p.url }}">Choose size</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  <div class="aapr__toast" role="status" data-toast><span>Added to cart</span><a href="/cart">View cart</a></div>
</div>
<script>
(function(){
  var root=document.getElementById('aapr-{{ section.id }}'); if(!root) return;
  var toast=root.querySelector('[data-toast]'),tm;
  function show(){toast.classList.add('on');clearTimeout(tm);tm=setTimeout(function(){toast.classList.remove('on')},2500)}
  root.addEventListener('click',function(e){
    var b=e.target.closest('button[data-qa]'); if(!b||!root.contains(b)) return;
    e.preventDefault(); if(b.disabled) return;
    var btns=b.parentNode.querySelectorAll('button'); btns.forEach(function(x){x.disabled=true});
    if (!window.AACD || !window.AACD.submit) {
      btns.forEach(function (button) { button.disabled = false; });
      alert('The cart is still loading. Please try again.');
      return;
    }
    var buyNow = b.dataset.qa === 'buy';
    window.AACD.submit([{ id: Number(b.dataset.v), quantity: 1 }], buyNow)
      .then(function () { if (!buyNow) show(); })
      .catch(function(err){alert((err&&err.description)||'Could not add to cart. Please try again.')})
      .finally(function(){btns.forEach(function(x){x.disabled=false})});
  });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Araadhya product row",
  "tag": "section",
  "class": "aapr-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "view_all", "label": "View all text", "default": "View all" },
    { "type": "checkbox", "id": "divider", "label": "Dotted line above", "default": false },
    { "type": "text", "id": "badge", "label": "Badge on the line (optional)" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Araadhya product row" }]
}
{% endschema %}
