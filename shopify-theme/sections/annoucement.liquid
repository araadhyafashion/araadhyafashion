{% liquid
  assign show = section.settings.show_announcement
  if section.settings.homepage_only and request.page_type != 'index'
    assign show = false
  endif
%}

{% if show %}
  <section
    id="m-announcement--{{ section.id }}"
    class="aa-announcement-marquee"
    aria-label="Announcement"
  >
    <div class="aa-marquee-wrapper">
      <div class="aa-marquee-track">
        {%- capture marquee_content -%}
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> FREE SHIPPING ACROSS INDIA</span>
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> CASH ON DELIVERY AVAILABLE NATIONWIDE</span>
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> 100% HAND-EMBROIDERED IN LUCKNOW</span>
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> EXTRA 10% OFF FIRST ORDER: CODE <strong>WELCOME10</strong></span>
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> DISPATCHED WITHIN 24–48 HOURS</span>
          <span class="aa-marquee-item"><span class="aa-sparkle">✦</span> WORLDWIDE EXPRESS DELIVERY (4–7 DAYS)</span>
        {%- endcapture -%}
        <div class="aa-marquee-group">{{ marquee_content }}</div>
        <div class="aa-marquee-group" aria-hidden="true">{{ marquee_content }}</div>
        <div class="aa-marquee-group" aria-hidden="true">{{ marquee_content }}</div>
      </div>
    </div>
  </section>

  <style>
    .aa-announcement-marquee {
      background: #0B382C !important;
      color: #FDFBF7 !important;
      overflow: hidden !important;
      width: 100% !important;
      height: 38px !important;
      min-height: 38px !important;
      display: flex !important;
      align-items: center !important;
      position: relative !important;
      z-index: 100 !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .aa-marquee-wrapper {
      width: 100% !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      position: relative !important;
    }
    .aa-marquee-track {
      display: flex !important;
      flex-shrink: 0 !important;
      align-items: center !important;
      white-space: nowrap !important;
      animation: aaMarqueeScroll 28s linear infinite !important;
      will-change: transform !important;
    }
    .aa-announcement-marquee:hover .aa-marquee-track,
    .aa-announcement-marquee:active .aa-marquee-track {
      animation-play-state: paused !important;
    }
    .aa-marquee-group {
      display: flex !important;
      align-items: center !important;
      flex-shrink: 0 !important;
    }
    .aa-marquee-item {
      display: inline-flex !important;
      align-items: center !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      padding: 0 24px !important;
      color: #FDFBF7 !important;
      white-space: nowrap !important;
      line-height: 38px !important;
    }
    .aa-sparkle {
      color: #F2D594 !important;
      margin-right: 8px !important;
      font-size: 10px !important;
    }
    .aa-marquee-item strong {
      color: #F2D594 !important;
      margin-left: 4px !important;
      letter-spacing: 0.14em !important;
    }
    @keyframes aaMarqueeScroll {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-33.33333%, 0, 0); }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "label": "Home page only",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
