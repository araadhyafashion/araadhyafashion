{%- comment -%}
  Araadhya Fashion - Clean Native Shopify Markets Currency & Country Selector
  Supports INR (₹), USD ($), AED (AED), GBP (£), CAD (C$), EUR (€)
  Zero external app dependency - uses native Shopify Localization API
{%- endcomment -%}

{%- if localization.available_countries.size > 1 -%}
  <div class="aa-currency-switcher" data-currency-switcher>
    {%- form 'localization', id: 'HeaderCountryForm', class: 'aa-localization-form' -%}
      <div class="aa-curr-select-wrapper">
        <label for="HeaderCountrySelect" class="visually-hidden">Choose Currency</label>
        <div class="aa-curr-trigger" tabindex="0" role="button" aria-haspopup="listbox" aria-expanded="false">
          <span class="aa-curr-flag">{{ localization.country.iso_code }}</span>
          <span class="aa-curr-currency">{{ localization.country.currency.iso_code }} ({{ localization.country.currency.symbol }})</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 1l4 4 4-4"/>
          </svg>
        </div>
        <select name="country_code" id="HeaderCountrySelect" class="aa-curr-native-select" onchange="this.form.submit()">
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
              {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endform -%}
  </div>

  <style>
    .aa-currency-switcher {
      display: inline-flex;
      align-items: center;
      font-family: inherit;
      font-size: 12px;
      color: inherit;
    }
    .aa-curr-select-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
    }
    .aa-curr-native-select {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }
    .aa-curr-trigger {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.1);
      cursor: pointer;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .aa-curr-trigger:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    .visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }
  </style>
{%- endif -%}
